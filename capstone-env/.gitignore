# Secrets
.env

# Experiment outputs (keep the directory, ignore contents)
results/*
!results/.gitkeep

# Logs (generated by FinVault at runtime)
logs/

# Caches
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# Data: raw is fetched + read-only, interim is regenerated by scripts
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
