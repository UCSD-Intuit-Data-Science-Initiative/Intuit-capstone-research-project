# Copy to .env and fill in your keys.
# .env is git-ignored — never commit real keys.

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local Qwen (configs/local_qwen.yaml, llama.cpp or Ollama): any value; neither server checks it.
OLLAMA_API_KEY=
JUPYTER_TOKEN=capstone

# Optional: copy finished runs to Langfuse for browsing (make run ARGS="... --langfuse").
# Leave blank to keep runs local only. LANGFUSE_BASE_URL is only needed for another region
# or a self-hosted server.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
